#!/usr/bin/env bash
# tgrid — tile native macOS Terminal.app windows into a grid.
# Each window is a real, separate Terminal window = a real, separate shell/session.
# No multiplexer, no split panes, no tmux.
#
#   tgrid            open 4 Terminal windows running `claude` in a 2x2 grid
#   tgrid 6          6 windows, 3x2
#   tgrid 2 -c zsh   2 plain shells
#   tgrid --reflow   re-tile the Terminal windows that are ALREADY open
#   tgrid --deck     one window centred, the rest peeking in from the edges
#   tgrid --next     with the deck: swipe to the next window
#   tgrid --theme    ...and give every cell its own colour and a clean title bar
#   tgrid --undo     put them back where they were before the last tile
#   tgrid --help
set -euo pipefail

VERSION="1.4"
N=4
CMD="claude"
DIR="$PWD"
ROWS=0
COLS=0
GAP=6
PAD=0
DISPLAY_IDX=0
REFLOW=0
FILL=0
UNDO=0
HERE=0
DIRS=""
THEME="${TGRID_THEME:-0}"      # 0 leave appearance alone · 1 apply · 2 strip
FONT=0
DECK=0
STEP=0
# The accent palette, single source of truth — the profile writer below needs it
# to bake the background colour, and the JXA needs it for the cursor.
# Ordered for neighbours, not for the colour wheel: alternating warm and cool
# means whichever window you land on, the one beside it looks different.
ACCENTS="0.424,0.549,1.000;0.914,0.706,0.298;0.184,0.831,0.745;1.000,0.420,0.545;0.420,0.831,0.494;0.655,0.545,0.980;1.000,0.561,0.302;0.298,0.780,0.941"
GROUND=0.035     # how dark the ground is before the accent is mixed in
CAST=0.042       # how much accent goes into it
ALPHA=0.88       # window opacity — the glass
BLUR=0.55        # how hard the backdrop is blurred behind it
REPROFILE=0
MAINPCT=58
PEEK=150
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/tgrid"
STATE="$CACHE/last-layout.json"

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
  cat <<'EOF'

Options
  -c, --cmd CMD      command to run in each window (default: claude; "" = plain shell)
  -d, --dir DIR      working directory for every window (default: cwd)
      --dirs a,b,c   per-window working directories (overrides -d, sets N)
  -r, --rows N       force row count
  -k, --cols N       force column count
  -g, --gap PX       gap between windows (default: 6)
  -p, --pad PX       outer margin around the grid (default: 0)
  -D, --display N    display index, 0 = main; "next" = the other monitor
      --reflow       do not open anything; just tile existing Terminal windows
      --fill         with --reflow: open the windows the chosen grid is short of
      --here         with --reflow: only tile windows already on the target display
      --undo         restore the window positions from before the last tile
  -t, --theme        style the windows: one accent per cell, title bar stripped
                     down to what the shell put there, font fitted to the cell
      --deck         one window centred, the others peeking in from the edges
      --next         with --deck: bring the next window to the centre
      --prev         with --deck: bring the previous one
      --main PCT     width of the centred window, % of the screen (default: 58)
      --peek PX      how much of the nearest side window stays visible (150)
      --opaque       theme without the glass — solid windows, no blur
      --reprofile    rebuild t-GRID's Terminal profiles (after changing the look)
      --palette      print the accent colours as hex, one per line
      --plain        undo that — put the windows back on your default profile
      --font PT      font size for --theme (default: fitted to the cell)
      --version      print version
  -h, --help         this
EOF
}

die() { echo "tgrid: $*" >&2; exit 1; }

# Every option that takes a value goes through need(), so a missing value is a
# clear message instead of bash's "unbound variable". It gets the live argument
# count, because `-c ""` is legitimate (plain shell) while `-c` alone is not.
need() {
  [[ "$2" -ge 2 ]] || die "$1 needs a value"
  [[ ! "$3" =~ ^-{1,2}[a-zA-Z] ]] || die "$1 needs a value (got the flag $3)"
}
num()  { [[ "$2" =~ ^[0-9]+$ ]] || die "$1 expects a number, got '$2'"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--cmd)     need "$1" "$#" "${2-}"; CMD="$2"; shift 2 ;;
    -d|--dir)     need "$1" "$#" "${2-}"; DIR="$2"; shift 2 ;;
    --dirs)       need "$1" "$#" "${2-}"; DIRS="$2"; shift 2 ;;
    -r|--rows)    need "$1" "$#" "${2-}"; num "$1" "$2"; ROWS="$2"; shift 2 ;;
    -k|--cols)    need "$1" "$#" "${2-}"; num "$1" "$2"; COLS="$2"; shift 2 ;;
    -g|--gap)     need "$1" "$#" "${2-}"; num "$1" "$2"; GAP="$2"; shift 2 ;;
    -p|--pad)     need "$1" "$#" "${2-}"; num "$1" "$2"; PAD="$2"; shift 2 ;;
    -D|--display) need "$1" "$#" "${2-}"
                  [[ "$2" == "next" || "$2" == "other" ]] || num "$1" "$2"
                  DISPLAY_IDX="$2"; shift 2 ;;
    --reflow)     REFLOW=1; shift ;;
    --fill)       FILL=1; shift ;;
    --here)       HERE=1; shift ;;
    --deck)       DECK=1; shift ;;
    --next)       DECK=1; STEP=1; shift ;;
    --prev)       DECK=1; STEP=-1; shift ;;
    --main)       need "$1" "$#" "${2-}"; num "$1" "$2"; MAINPCT="$2"; shift 2 ;;
    --peek)       need "$1" "$#" "${2-}"; num "$1" "$2"; PEEK="$2"; shift 2 ;;
    -t|--theme)   THEME=1; shift ;;
    --opaque)     THEME=1; ALPHA=1.0; BLUR=0.0; shift ;;
    --reprofile)  THEME=1; REPROFILE=1; shift ;;
    --plain)      THEME=2; shift ;;
    --font)       need "$1" "$#" "${2-}"; num "$1" "$2"; FONT="$2"; shift 2 ;;
    --undo)       UNDO=1; shift ;;
    --palette)    # one accent per line as hex — so anything drawing UI on top of
                  # these windows (the nameplates) uses the same colours instead
                  # of keeping its own copy that drifts
                  # LC_ALL=C: under a comma-decimal locale awk reads 0.424 as 0,
                  # which silently turns the whole palette into pure primaries
                  LC_ALL=C awk -v pal="$ACCENTS" 'BEGIN{
                    n=split(pal,a,";");
                    for(i=1;i<=n;i++){split(a[i],c,",");
                      printf "#%02X%02X%02X\n", int(c[1]*255+0.5), int(c[2]*255+0.5), int(c[3]*255+0.5)}}'
                  exit 0 ;;
    --version)    echo "tgrid $VERSION"; exit 0 ;;
    -h|--help)    usage; exit 0 ;;
    [0-9]*)       num "count" "$1"; N="$1"; shift ;;
    *)            echo "tgrid: unknown option $1" >&2; usage >&2; exit 1 ;;
  esac
done

[[ -d "$DIR" ]] || die "no such directory: $DIR"
DIR="$(cd "$DIR" && pwd)"

# resolve ~ and relative paths in --dirs, and fail loudly on a bad one
if [[ -n "$DIRS" ]]; then
  resolved=""
  IFS=',' read -ra _parts <<< "$DIRS"
  for p in "${_parts[@]}"; do
    p="${p#"${p%%[![:space:]]*}"}"          # ltrim
    p="${p%"${p##*[![:space:]]}"}"          # rtrim
    [[ -z "$p" ]] && continue
    p="${p/#\~/$HOME}"
    [[ -d "$p" ]] || die "--dirs: no such directory: $p"
    resolved+="$(cd "$p" && pwd),"
  done
  DIRS="${resolved%,}"
fi

mkdir -p "$CACHE"

# ---- t-GRID's own Terminal profiles ----------------------------------------
# Colours and font can be set on a profile over AppleScript. The title bar
# cannot: `albert —` is the represented-URL proxy and `— -zsh` the active
# process name, and both live ONLY in the profile plist — setting every title
# switch AppleScript exposes changes nothing you can see. So each profile has to
# be BORN from a `.terminal` file that carries those keys.
#
# Importing one means opening it, and that `open` has to happen HERE rather than
# from inside the JXA below: while our own script is holding Terminal inside an
# Apple Event, Terminal never gets round to processing the open, and the profile
# silently never appears. Costs one throwaway window per profile, once ever.
win_ids() {
  osascript -l JavaScript -e \
    'Application("Terminal").windows().map(function(w){try{return w.id()}catch(e){return ""}}).join(",")' \
    2>/dev/null || true
}

theme_import() {
  local name="$1" acc="$2" path="$CACHE/$1.terminal" before
  # The background colour carries the cell's hue AND the window's opacity, and
  # opacity is reachable ONLY as the alpha of an archived NSColor. AppleScript's
  # `background color` takes three components and silently drops the fourth, so
  # this half has to be written as a real plist and imported.
  osascript -l JavaScript - "$path" "$name" "$acc" "$GROUND" "$CAST" "$ALPHA" "$BLUR" <<'JXA' >/dev/null 2>&1 || return 1
function run(argv) {
  ObjC.import('AppKit'); ObjC.import('Foundation');
  var path = argv[0], name = argv[1];
  var acc = argv[2].split(',').map(parseFloat);
  var ground = parseFloat(argv[3]), cast = parseFloat(argv[4]);
  var alpha = parseFloat(argv[5]), blur = parseFloat(argv[6]);
  var col = $.NSColor.colorWithSRGBRedGreenBlueAlpha(
    ground + acc[0] * cast, ground + acc[1] * cast, ground + acc[2] * cast, alpha);
  var data = $.NSKeyedArchiver.archivedDataWithRootObjectRequiringSecureCodingError(col, false, null);
  var d = $.NSMutableDictionary.alloc.init;
  d.setObjectForKey($(name), $('name'));
  d.setObjectForKey($('Window Settings'), $('type'));
  d.setObjectForKey(data, $('BackgroundColor'));
  d.setObjectForKey($.NSNumber.numberWithDouble(blur), $('BackgroundBlur'));
  // the title-bar keys that have no AppleScript switch
  ['ShowRepresentedURLInTitle', 'ShowRepresentedURLPathInTitle',
   'ShowActiveProcessInTitle', 'ShowActiveProcessArgumentsInTitle',
   'ShowShellCommandInTitle', 'ShowTTYNameInTitle', 'ShowDimensionsInTitle',
   'ShowWindowSettingsNameInTitle', 'ShowCommandKeyInTitle'].forEach(function (k) {
    d.setObjectForKey($.NSNumber.numberWithBool(false), $(k));
  });
  return d.writeToFileAtomically($(path), true) ? 'ok' : 'fail';
}
JXA
  before="$(win_ids)"
  open -a Terminal "$path" 2>/dev/null || return 1
  osascript -l JavaScript - "$name" "$before" <<'JXA' >/dev/null 2>&1
function run(argv) {
  ObjC.import('Foundation');
  var name = argv[0], before = {};
  argv[1].split(',').forEach(function (s) { if (s) before[s] = true; });
  var T = Application('Terminal');
  function delay(s) { $.NSThread.sleepForTimeInterval(s); }
  function ids() {
    var o = [], ws = T.windows;
    for (var i = 0; i < ws.length; i++) { try { o.push(ws[i].id()); } catch (e) {} }
    return o;
  }
  var ok = false;
  for (var i = 0; i < 50 && !ok; i++) {
    delay(0.1);
    try { ok = T.settingsSets.name().indexOf(name) >= 0; } catch (e) {}
  }
  delay(0.2);
  // The window the import opened is litter. Terminal will not close a window
  // whose shell is still running — it puts up a sheet instead of failing, so
  // close() reports success and nothing happens. Exit the shell first.
  var strays = ids().filter(function (id) { return !before[id]; });
  strays.forEach(function (id) {
    try { T.doScript('exit', { in: T.windows.byId(id).tabs[0] }); } catch (e) {}
  });
  if (strays.length) delay(1.2);
  strays.forEach(function (id) { try { T.windows.byId(id).close(); } catch (e) {} });
  return ok ? 'ok' : 'timeout';
}
JXA
}

# Build only the profiles this grid will actually use, so the one-off window
# flicker is as small as possible. Eight accents is the whole palette.
theme_setup() {
  local want="$1" sets i acc
  [[ "$THEME" == "1" ]] || return 0
  (( want > 8 )) && want=8
  # The look is baked into the profile at import time, so changing it means
  # throwing the profiles away and building them again.
  if [[ "$REPROFILE" == "1" ]]; then
    osascript -l JavaScript -e '
      var T = Application("Terminal");
      T.settingsSets.name().forEach(function (n) {
        if (n.indexOf("t-GRID ") === 0) { try { T.settingsSets.byName(n).delete(); } catch (e) {} }
      });' >/dev/null 2>&1 || true
  fi
  sets="$(osascript -l JavaScript -e 'Application("Terminal").settingsSets.name().join("\n")' 2>/dev/null || true)"
  for ((i = 1; i <= want; i++)); do
    acc="$(cut -d';' -f"$i" <<< "$ACCENTS")"
    grep -qxF "t-GRID $i" <<< "$sets" || theme_import "t-GRID $i" "$acc"
  done
}

if [[ "$THEME" == "1" ]]; then
  if [[ "$REFLOW" == "1" || "$DECK" == "1" ]]; then
    theme_setup "$(osascript -l JavaScript -e 'Application("Terminal").windows().length' 2>/dev/null || echo 4)"
  elif [[ -n "$DIRS" ]]; then
    theme_setup "$(awk -F, '{print NF}' <<< "$DIRS")"
  else
    theme_setup "$N"
  fi
fi

case "$DISPLAY_IDX" in next|other) DISPLAY_IDX=-1 ;; esac

# Args are passed positionally — no JSON, no python, nothing to escape wrong.
osascript -l JavaScript - \
  "$N" "$CMD" "$DIR" "$DIRS" "$ROWS" "$COLS" "$GAP" "$PAD" \
  "$DISPLAY_IDX" "$REFLOW" "$UNDO" "$HERE" "$STATE" "$FILL" \
  "$THEME" "$FONT" "$CACHE" "$DECK" "$STEP" "$MAINPCT" "$PEEK" "$ACCENTS" <<'JXA'
function run(argv) {
  ObjC.import('AppKit');
  ObjC.import('Foundation');
  function delay(sec) { $.NSThread.sleepForTimeInterval(sec); }

  var a = {
    n: parseInt(argv[0], 10),
    cmd: argv[1],
    dir: argv[2],
    dirs: argv[3] ? argv[3].split(',').filter(function (s) { return s.length; }) : [],
    rows: parseInt(argv[4], 10),
    cols: parseInt(argv[5], 10),
    gap: parseInt(argv[6], 10),
    pad: parseInt(argv[7], 10),
    display: parseInt(argv[8], 10),
    reflow: argv[9] === '1',
    undo: argv[10] === '1',
    here: argv[11] === '1',
    state: argv[12],
    fill: argv[13] === '1',
    theme: parseInt(argv[14], 10),
    font: parseInt(argv[15], 10),
    cache: argv[16],
    deck: argv[17] === '1',
    step: parseInt(argv[18], 10),
    mainPct: Math.max(30, Math.min(90, parseInt(argv[19], 10))),
    peek: Math.max(30, parseInt(argv[20], 10)),
    accents: argv[21].split(';').map(function (t) { return t.split(',').map(parseFloat); })
  };

  var Term = Application('Terminal');
  Term.includeStandardAdditions = true;

  // ---- little helpers -------------------------------------------------
  // single-quote escaping: a directory named  /tmp/$(whoami)  must stay a
  // directory name and not become a command substitution
  function shq(s) { return "'" + String(s).replace(/'/g, "'\\''") + "'"; }

  function baseName(p) {
    var t = String(p).replace(/\/+$/, '');
    var i = t.lastIndexOf('/');
    return (i >= 0 ? t.slice(i + 1) : t) || '/';
  }

  // Stripping the title bar down to the custom title is only an improvement if
  // something puts a custom title there. An agent does — Claude Code writes the
  // task it is on — but a plain shell writes nothing, and the window would just
  // say "Terminal". So name it on the way in: cell number and folder. Anything
  // running afterwards is free to overwrite it, which is the point.
  function titleCmd(i, dir) {
    var t = (i + 1) + ' · ' + baseName(dir);
    return "printf " + shq('\\033]0;' + t.replace(/[\x00-\x1f]/g, '') + '\\007');
  }

  function windowIds() {
    var out = [], ws = Term.windows;
    for (var i = 0; i < ws.length; i++) { try { out.push(ws[i].id()); } catch (e) {} }
    return out;
  }
  // Which window did doScript just create? Diffing window ids was the obvious
  // answer and it is subtly wrong: Terminal's window list can come back short
  // for a call — a session parked on another display's Space went missing for
  // exactly one enumeration — and then an id that had been there all along
  // looks new. The result is that a window you were working in gets adopted
  // into the grid and resized under you. doScript hands back the TAB it made,
  // and a tty is unique, so ask the tab which window it lives in. Id diffing
  // stays on as the fallback.
  function windowForTab(tab, known) {
    var tty = null;
    try { tty = tab.tty(); } catch (e) {}
    if (tty) {
      var ws = Term.windows;
      for (var i = 0; i < ws.length; i++) {
        try {
          var ts = ws[i].tabs;
          for (var j = 0; j < ts.length; j++) {
            if (ts[j].tty() === tty) return ws[i].id();
          }
        } catch (e) {}
      }
    }
    var now = windowIds();
    for (var k = 0; k < now.length; k++) { if (!known[now[k]]) return now[k]; }
    return null;
  }

  function boundsOf(id) { try { return Term.windows.byId(id).bounds(); } catch (e) { return null; } }

  function writeJSONFile(path, obj) {
    try {
      var s = $.NSString.alloc.initWithUTF8String(JSON.stringify(obj));
      s.writeToFileAtomicallyEncodingError($(path), true, $.NSUTF8StringEncoding, null);
    } catch (e) {}
  }
  function readJSONFile(path) {
    try {
      var s = $.NSString.stringWithContentsOfFileEncodingError($(path), $.NSUTF8StringEncoding, null);
      return s.isNil() ? null : JSON.parse(ObjC.unwrap(s));
    } catch (e) { return null; }
  }
  function writeState(obj) { writeJSONFile(a.state, obj); }
  function readState() { return readJSONFile(a.state); }

  function place(id, cell) {
    var win;
    try { win = Term.windows.byId(id); } catch (e) { return; }
    // Terminal READS and WRITES `bounds` in different coordinate spaces as soon as
    // a display sits above the primary one: the getter's origin is the top of the
    // primary screen, the setter's is the top of the whole desktop. With a 1440p
    // above a 1080p that is a constant 411px — enough to drop the second row on
    // top of the first, which is exactly what it looked like.
    //
    // The offset is not worth hardcoding: it changes with the monitor arrangement.
    // Place, read back, correct by the difference. Converges in two passes for any
    // pure translation, and stops on its own when Terminal clamps and cannot land.
    var want = { x: cell.x, y: cell.y, width: cell.width, height: cell.height };
    for (var pass = 0; pass < 3; pass++) {
      // set twice: Terminal quantises to character cells and can clamp on the first
      try { win.bounds = want; } catch (e) { return; }
      try { win.bounds = want; } catch (e) {}
      var got;
      try { got = win.bounds(); } catch (e) { return; }
      var dx = cell.x - got.x, dy = cell.y - got.y;
      if (Math.abs(dx) <= 2 && Math.abs(dy) <= 2) return;
      want = { x: want.x + dx, y: want.y + dy,
               width: want.width, height: want.height };
    }
  }


  // ---- terminal design -------------------------------------------------
  // Six identical dark rectangles read as one wall of text. The theme gives
  // every cell in the grid its own near-black tint and a matching cursor, and
  // strips the title bar back to what the shell actually put there.
  //
  // It takes two layers, because Terminal splits the job in an unobvious place:
  //
  //   * Colours and font ARE settable on a settings set over AppleScript, and a
  //     set created that way inherits a working ANSI palette — so agent output
  //     keeps its reds and greens. No plist surgery needed for any of that.
  //   * The noisy half of the title has NO AppleScript switch. `albert —` is
  //     the represented-URL proxy and `— -zsh` the active process name; both
  //     live only in the profile plist. Setting every title flag AppleScript
  //     does expose changes nothing you can see. The profile therefore has to
  //     be BORN from a `.terminal` file carrying those keys — and importing one
  //     registers a real settings set, which can then be handed to windows that
  //     are already open. That last part is the whole trick.

  var ACCENTS = a.accents;
  // One neutral text colour everywhere, so reading never changes between cells.
  // The accent is spent in exactly two places: a hue cast in the background you
  // only notice with a neighbour beside it, and the cursor, which is the one
  // thing you hunt for. Bold stays neutral — tinting it would make a red cell's
  // headings look like errors.
  var TEXT = [0.780, 0.796, 0.831];
  var BOLD = [0.949, 0.957, 0.973];
  function profileName(i) { return 't-GRID ' + ((i % ACCENTS.length) + 1); }

  // Terminal quantises to whole character cells. Solving two measured windows
  // (849x702 = 116x43 and 597x409 = 80x24, both at 11pt) gives a column of
  // 0.6364*size points and a row of 1.402*size, plus ~37pt of chrome across and
  // ~39pt down. So this is arithmetic, not a guess. Pick the largest size that
  // still leaves TARGET_COLS columns: a denser grid gets smaller type instead of
  // an agent UI clipped down the right-hand side.
  var COL_W = 0.6364, ROW_H = 1.402, CHROME_W = 37, CHROME_H = 39;
  var TARGET_COLS = 100, MIN_ROWS = 20;
  function fitFont(w, h) {
    var byW = (w - CHROME_W) / (COL_W * TARGET_COLS);
    var byH = (h - CHROME_H) / (ROW_H * MIN_ROWS);
    return Math.max(9, Math.min(16, Math.floor(Math.min(byW, byH))));
  }

  function settingsNames() { try { return Term.settingsSets.name(); } catch (e) { return []; } }

  // Paint the profile for cell i. The profiles themselves were imported by the
  // shell half of this script before we got here; if one is missing, that cell
  // simply keeps the look it had. Profiles are t-GRID's own — Basic and Pro are
  // never touched.
  function themeFor(i, font, w, h) {
    var name = profileName(i);
    if (settingsNames().indexOf(name) < 0) return null;
    var set;
    try { set = Term.settingsSets.byName(name); } catch (e) { return null; }
    var acc = ACCENTS[i % ACCENTS.length];
    try {
      // NOT the background: it was baked into the profile at import time,
      // carrying the window's opacity as its alpha. Writing it from here would
      // silently drop that and turn the glass solid again.
      set.normalTextColor = TEXT;
      set.boldTextColor   = BOLD;
      set.cursorColor     = acc;
      set.fontName = 'SFMono-Regular';
      set.fontSize = font;
      // Sizing the profile to the cell keeps the window from jumping when the
      // profile lands; place() still has the final word.
      set.numberOfColumns = Math.max(20, Math.floor((w - CHROME_W) / (COL_W * font)));
      set.numberOfRows    = Math.max(10, Math.floor((h - CHROME_H) / (ROW_H * font)));
      // the half of the title bar AppleScript can reach — the plist did the rest
      set.titleDisplaysDeviceName   = false;
      set.titleDisplaysShellPath    = false;
      set.titleDisplaysWindowSize   = false;
      set.titleDisplaysSettingsName = false;
      set.titleDisplaysCustomTitle  = true;
    } catch (e) {}
    return set;
  }

  // theme 1 = dress, 2 = strip back to whatever the user's default profile is.
  // Runs before the final placement pass, because applying a profile resizes the
  // window to that profile's rows and columns.
  function dress(ids, w, h) {
    if (!a.theme) return;
    if (w === undefined) { var c0 = cellFor(0); w = c0.width; h = c0.height; }
    var font = a.font > 0 ? a.font : fitFont(w, h);
    for (var i = 0; i < ids.length; i++) {
      var set = null;
      if (a.theme === 1) { set = themeFor(i, font, w, h); }
      else { try { set = Term.defaultSettings; } catch (e) {} }
      if (!set) continue;
      try { Term.windows.byId(ids[i]).tabs[0].currentSettings = set; } catch (e) {}
    }
    delay(0.3);
  }

  // ---- deck: one window centred, the rest peeking in from the edges ------
  // The grid answers "show me everything at once". The deck answers the other
  // half of the day: one thing has your attention, the rest should be one
  // keystroke away and otherwise out of the way. Same windows, same sessions —
  // only the arithmetic changes.
  //
  // The order is a RING, held in the cache, so --next walks the same sequence
  // every time instead of jumping around by whatever is frontmost. Windows that
  // have closed since drop out; new ones join the end.
  function deckPath() { return a.cache + '/deck.json'; }

  function deckRing(ids) {
    var st = readJSONFile(deckPath()), ring = [];
    if (st && st.ring) {
      for (var i = 0; i < st.ring.length; i++) {
        if (ids.indexOf(st.ring[i]) >= 0 && ring.indexOf(st.ring[i]) < 0) ring.push(st.ring[i]);
      }
    }
    for (var j = 0; j < ids.length; j++) { if (ring.indexOf(ids[j]) < 0) ring.push(ids[j]); }
    return ring;
  }

  function runDeck(ids, X, Y, W, H) {
    var ring = deckRing(ids);
    var n = ring.length;
    if (!n) { return 'tgrid: no Terminal windows to deck'; }

    var st = readJSONFile(deckPath());
    var cur = 0;
    if (st && typeof st.cur === 'number' && st.ring) {
      // follow the window that was centred last, not its old index — the ring
      // may have lost or gained members since
      var was = st.ring[st.cur];
      var seat = ring.indexOf(was);
      if (seat >= 0) cur = seat;
    } else {
      // first deck of the session: centre whatever is already frontmost, so
      // this rearranges around you instead of yanking a different session up
      try {
        var front = Term.windows[0].id();
        var f = ring.indexOf(front);
        if (f >= 0) cur = f;
      } catch (e) {}
    }
    if (a.step) cur = ((cur + a.step) % n + n) % n;

    var mainW = Math.round(W * a.mainPct / 100);
    var inset = n > 1 ? 26 : 0;          // side windows sit a little inside the
                                         // main one, which is what reads as depth
    var main = { x: X + Math.round((W - mainW) / 2), y: Y, width: mainW, height: H };

    // Depth 1 shows `peek` pixels; each one behind it shows less and sits further
    // off the edge, so a stack of five still looks like a stack and not a smear.
    function side(dir, depth) {
      var vis = Math.max(34, a.peek - Math.min(depth - 1, 4) * 34);
      return {
        x: dir > 0 ? (X + W - vis) : (X + vis - mainW),
        y: Y + inset,
        width: mainW,
        height: H - 2 * inset
      };
    }

    // Walk out from the centre alternating right, left, right, left …
    function at(offset) { return ring[((cur + offset) % n + n) % n]; }
    var plan = [];
    for (var k = 1; k < n; k++) {
      var dir = (k % 2) ? 1 : -1;
      var depth = Math.ceil(k / 2);
      plan.push({ id: at(dir * depth), cell: side(dir, depth), depth: depth });
    }

    Term.activate();
    // Dress by RING order, not by where a window happens to sit right now.
    // Colouring by position would repaint every window on every swipe, which
    // destroys the one thing the colour is for: staying the same.
    if (a.theme) dress(ring, main.width, main.height);

    // Place and raise from the back forward, so the nearer window of a stack
    // ends up on top of the one behind it, and the centred one on top of all.
    plan.sort(function (p, q) { return q.depth - p.depth; });
    for (var i = 0; i < plan.length; i++) {
      place(plan[i].id, plan[i].cell);
      try { Term.windows.byId(plan[i].id).frontmost = true; } catch (e) {}
    }
    place(ring[cur], main);
    delay(0.15);
    for (var r = 0; r < plan.length; r++) place(plan[r].id, plan[r].cell);
    place(ring[cur], main);
    try { Term.windows.byId(ring[cur]).frontmost = true; } catch (e) {}

    writeJSONFile(deckPath(), { ring: ring, cur: cur });

    var name = '';
    try { name = Term.windows.byId(ring[cur]).name(); } catch (e) {}
    return 'tgrid: deck of ' + n + ' — ' + (name || 'window ' + ring[cur]) + ' in the middle';
  }

  // ---- undo -----------------------------------------------------------
  if (a.undo) {
    var prev = readState();
    if (!prev || !prev.length) { return 'tgrid: nothing to undo'; }
    Term.activate();
    var restored = 0;
    for (var u = 0; u < prev.length; u++) {
      if (boundsOf(prev[u].id) === null) continue;   // window is gone
      place(prev[u].id, { x: prev[u].x, y: prev[u].y, width: prev[u].width, height: prev[u].height });
      restored++;
    }
    return 'tgrid: restored ' + restored + ' window(s)';
  }

  // ---- geometry: visible frame of the target display, flipped to AppleScript coords
  // (Cocoa: origin bottom-left of the primary screen. AppleScript: origin top-left.)
  var screens = $.NSScreen.screens;
  var count = screens.count;
  var primary = screens.objectAtIndex(0);
  var flipRef = primary.frame.size.height;
  function topOf(rect) { return Math.round(flipRef - (rect.origin.y + rect.size.height)); }

  // Terminal refuses to put a window under the menu bar — and with "Displays have
  // separate Spaces" every display has one, even though only the primary reports
  // it in visibleFrame. Reserve it everywhere or the bottom row hangs off-screen.
  var pBottomInset = primary.visibleFrame.origin.y - primary.frame.origin.y;
  var menuBar = primary.frame.size.height - primary.visibleFrame.size.height - pBottomInset;

  // A window belongs to a display if it OVERLAPS it, not if its left edge
  // happens to land inside it. The deck deliberately pushes its side windows
  // past the edge into negative coordinates, and an origin-only test then
  // decides they live on the next monitor along — so --here quietly dropped
  // them and the deck shrank by two windows on every swipe.
  function overlapsScreen(b, i) {
    var fr = screens.objectAtIndex(i).frame;
    var left = Math.round(fr.origin.x), right = left + Math.round(fr.size.width);
    return b.x < right && (b.x + b.width) > left;
  }

  function screenIndexForX(x) {
    for (var s = 0; s < count; s++) {
      var fr = screens.objectAtIndex(s).frame;
      var left = Math.round(fr.origin.x);
      if (x >= left && x < left + Math.round(fr.size.width)) return s;
    }
    return 0;
  }

  var idx = a.display;
  if (idx < 0) {
    // -D next: the display that is NOT holding the frontmost Terminal window
    var here = 0;
    try { here = screenIndexForX(Term.windows[0].bounds().x); } catch (e) {}
    idx = (here + 1) % count;
  }
  idx = Math.max(0, Math.min(idx, count - 1));

  var scr = screens.objectAtIndex(idx);
  var vf = scr.visibleFrame;
  var X = Math.round(vf.origin.x) + a.pad;
  var Y = topOf(vf) + a.pad;
  var W = Math.round(vf.size.width) - 2 * a.pad;
  var H = Math.round(vf.size.height) - 2 * a.pad;

  var minY = topOf(scr.frame) + menuBar + a.pad;
  if (Y < minY) { H -= (minY - Y); Y = minY; }

  if (a.deck) {
    var deckIds = [];
    var dws = Term.windows;
    for (var di = 0; di < dws.length; di++) {
      try {
        if (dws[di].miniaturized() || !dws[di].visible()) continue;
        if (a.here && !overlapsScreen(dws[di].bounds(), idx)) continue;
        deckIds.push(dws[di].id());
      } catch (e) {}
    }
    if (!deckIds.length) return 'tgrid: no Terminal windows to deck';
    var snap = [];
    windowIds().forEach(function (id) {
      var b = boundsOf(id);
      if (b) snap.push({ id: id, x: b.x, y: b.y, width: b.width, height: b.height });
    });
    writeState(snap);
    return runDeck(deckIds, X, Y, W, H);
  }

  // ---- decide which windows get tiled.
  // Always hold on to window IDs, never to windows[i] specifiers: those resolve
  // lazily by index, and the index shifts while windows are moved/raised — which
  // makes two cells grab the same window.
  var targets = [], where = {};
  if (a.reflow || a.deck) {
    var all = Term.windows;
    for (var i = 0; i < all.length; i++) {
      var w = all[i];
      try {
        if (w.miniaturized() || !w.visible()) continue;
        var wb = w.bounds();
        if (a.here && !overlapsScreen(wb, idx)) continue;
        targets.push(w.id());
        where[w.id()] = { x: wb.x, y: wb.y };
      } catch (e) { continue; }
    }
    if (targets.length === 0) {
      return a.here ? 'tgrid: no Terminal windows on that display'
                    : 'tgrid: no open Terminal windows to tile';
    }
  }

  var dirs = a.dirs.length ? a.dirs : null;
  var n = a.reflow ? targets.length : (dirs ? dirs.length : a.n);
  if (!(n >= 1)) { return 'tgrid: nothing to do'; }

  // ---- grid shape: wider than tall, since terminals like columns
  var cols = a.cols > 0 ? a.cols : Math.ceil(Math.sqrt(n));
  var rows = a.rows > 0 ? a.rows : Math.ceil(n / cols);
  if (a.cols > 0 && a.rows === 0) rows = Math.ceil(n / cols);
  if (a.rows > 0 && a.cols === 0) cols = Math.ceil(n / rows);
  // A forced grid smaller than the window count used to push the extra windows
  // off the bottom of the screen. Grow instead of losing them.
  if (rows * cols < n) rows = Math.ceil(n / cols);

  // ---- order the windows the way you would tidy a desk: reading order, by
  // where each window ALREADY is. Sorting by window id was stable but arbitrary
  // — ids follow creation order, so a tidy-up flung sessions across the screen
  // and looked random. Position ordering means a window moves to the nearest
  // cell and keeps its place as long as you leave it roughly where it was.
  if ((a.reflow || a.deck) && targets.length > 1) {
    // Tolerance for "same row". It has to absorb hand-placement drift without
    // swallowing a real row: half a cell was too generous — it merged two rows
    // 294px apart and produced column order instead of reading order.
    var band = 80;
    targets.sort(function (p, q) {
      var A = where[p] || { x: 0, y: 0 }, B = where[q] || { x: 0, y: 0 };
      if (Math.abs(A.y - B.y) > band) return A.y - B.y;
      if (A.x !== B.x) return A.x - B.x;
      return p - q;                       // identical spot: fall back to id
    });
  }

  var g = a.gap;
  function cellFor(i) {
    var r = Math.floor(i / cols);
    var c = i % cols;
    // last row: stretch the remaining windows across the full width
    var inRow = (r === rows - 1) ? (n - r * cols) : cols;
    if (inRow < 1) inRow = cols;
    var cw = Math.floor((W - g * (inRow - 1)) / inRow);
    var ch = Math.floor((H - g * (rows - 1)) / rows);
    return { x: X + c * (cw + g), y: Y + r * (ch + g), width: cw, height: ch };
  }

  // ---- remember where everything was, so --undo has something to go back to
  var snapshot = [];
  var allIds = windowIds();
  for (var si = 0; si < allIds.length; si++) {
    var b = boundsOf(allIds[si]);
    if (b) snapshot.push({ id: allIds[si], x: b.x, y: b.y, width: b.width, height: b.height });
  }
  writeState(snapshot);

  Term.activate();

  if (a.reflow) {
    // A chosen grid is a request for that many slots. Tiling 4 windows into a
    // 2x3 left two cells empty and stretched the last row across the full
    // width, which reads as broken. With --fill, open what is missing and hand
    // back the grid that was actually asked for. New windows go on the END of
    // the list, so the windows already on screen keep their cells.
    if (a.fill && rows * cols > targets.length) {
      var want = rows * cols - targets.length;
      var seen = {};
      var before = windowIds();
      for (var k = 0; k < before.length; k++) seen[before[k]] = true;

      for (var s2 = 0; s2 < want; s2++) {
        var script = 'cd ' + shq(a.dir) + ' && clear';
        if (a.theme === 1) script += ' && ' + titleCmd(targets.length, a.dir);
        if (a.cmd && a.cmd.length) script += ' && ' + a.cmd;
        var tabF = Term.doScript(script);
        delay(0.15);
        var idF = windowForTab(tabF, seen);
        if (idF !== null && !seen[idF]) { seen[idF] = true; targets.push(idF); }
      }
      n = targets.length;          // cellFor reads n, so the stretch stops here
      delay(0.3);                  // Terminal sizes a new window lazily
    }

    dress(targets);
    for (var i = 0; i < targets.length; i++) place(targets[i], cellFor(i));
    delay(0.2);
    for (var i2 = 0; i2 < targets.length; i2++) place(targets[i2], cellFor(i2));
    return 'tgrid: tiled ' + n + ' window(s) into ' + rows + 'x' + cols;
  }

  // ---- spawn n fresh windows, each its own shell, and place each one
  var known = {};
  var pre = windowIds();
  for (var p = 0; p < pre.length; p++) known[pre[p]] = true;

  var fresh = [];
  for (var i = 0; i < n; i++) {
    var d = dirs ? dirs[i] : a.dir;
    var script = 'cd ' + shq(d) + ' && clear';
    if (a.theme === 1) script += ' && ' + titleCmd(i, d);
    if (a.cmd && a.cmd.length) script += ' && ' + a.cmd;

    var tab = Term.doScript(script);
    delay(0.15);

    var wid = windowForTab(tab, known);
    if (wid !== null && !known[wid]) {
      known[wid] = true;
      fresh.push(wid);
      place(wid, cellFor(fresh.length - 1));
    }
  }

  // second pass: Terminal settles window sizes lazily after the shell starts
  delay(0.3);
  dress(fresh);
  for (var m = 0; m < fresh.length; m++) place(fresh[m], cellFor(m));

  if (fresh.length < n) {
    return 'tgrid: opened only ' + fresh.length + ' of ' + n + ' window(s) — Terminal refused the rest';
  }
  return 'tgrid: opened ' + fresh.length + ' window(s) in a ' + rows + 'x' + cols + ' grid';
}
JXA
